<?php

/**
 * Implements hook_uninstall().
 */
function bellcom_borgerdk_uninstall() {
  //getting the variables
  module_load_include('module', 'bellcom_borgerdk', 'bellcom_borgerdk');

  drupal_uninstall_schema('bellcom_borgerdk');

  $queue = DrupalQueue::get(BELLCOM_BORGERDK_QUEUE);
  $queue->deleteQueue();
}

/**
 * Implements hook_schema().
 */
function bellcom_borgerdk_schema() {
  $schema = array();

  $schema['borgerdk_article'] = array(
    'description' => 'Keeps the information about Borger.dk articles.',
    'fields' => array(
      'entity_id' => array(
        'description' => 'Primary key and id, taken from Borger.dk',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'title' => array(
        'description' => 'A title for the item, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'header' => array(
        'description' => 'A header for the item, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'articleUrl' => array(
        'description' => 'The URL of the article, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'legislation' => array(
        'description' => 'Legislation section of article, taken from Borger.dk',
        'type' => 'text',
        'size' => 'big',
      ),
      'recommendation' => array(
        'description' => 'Recommendation section of article, taken from Borger.dk',
        'type' => 'text',
        'size' => 'big',
      ),
      'byline' => array(
        'description' => 'The byline of the article, taken from Borger.dk',
