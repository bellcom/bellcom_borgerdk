      'content' => array(
        'description' => 'Content of the microarticle, taken from Borger.dk',
        'type' => 'text',
        'size' => 'big',
      ),
      'article_id' => array(
        'description' => 'Foreign key to borgerdk_article entity_id',
        'type' => 'int',
      ),
      'uid' => array(
        'description' => 'Author uid of this microarticle, 0 if imported automatically',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'changed' => array(
        'description' => 'The Unix timestamp of the entity changed time.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'description' => 'The Unix timestamp of the entity created time.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('entity_id'),
  );

  $schema['borgerdk_selfservice'] = array(
    'description' => 'Keeps the information about Borger.dk self-service links.',
    'fields' => array(
      'entity_id' => array(
        'description' => 'Primary key and id, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
      ),
      'title' => array(
        'description' => 'A title (href title attribute) for the self-service, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'label' => array(
        'description' => 'A label for the self-service, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'url' => array(
        'description' => 'The URL of the self-service, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'article_id' => array(
        'description' => 'Foreign key to borgerdk_article entity_id',
        'type' => 'int',
      ),
      'microarticle_id' => array(
        'description' => 'Foreign key to borgerdk_microarticle entity_id',
        'type' => 'varchar',
        'length' => 50,
