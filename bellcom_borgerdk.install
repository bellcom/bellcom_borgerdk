        'description' => 'Primary key and id, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
      ),
      'title' => array(
        'description' => 'A title for the microarticle, taken from Borger.dk',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
