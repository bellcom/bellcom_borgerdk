/**
 * Implements hook_mail()
 *
 * @param $key
 * @param $message
 * @param $params
 */
function bellcom_borgerdk_mail($key, &$message, $params) {
  $message['subject'] = $params['subject'];
  $message['body'][] = $params['body'];
}

/**
 * Helper function to return the list of entities ids for that need be deleted old revisions.
 *
 * @param string $entity_type
 *   A entity type machine name.
 * @param int $max_revisions
 *   Match entities with a total amount of revisions higher than this number.
 *
 * @return array
 *   Array of entity ids.
 */
function bellcom_borgerdk_entity_revision_delete_candidates($entity_type, $max_revisions) {
  $params = array(
    ':max_revisions' => $max_revisions,
  );
  $result = db_query('SELECT r.entity_id, count(*) as total
                     FROM {' . $entity_type . '_revision} r
                     GROUP BY r.entity_id
                     HAVING count(*) > :max_revisions
                     ORDER BY total DESC', $params);
  return $result->fetchCol();
}

/**
 * Deletes a entities revisions.
 *
 * @param int $entity_type
 *   The type of entity.
 * @param string $entity_id
 *   The entity ID whoose oldest revisions will be deleted.
 * @param int $revisions_to_keep
 *   Max amount of revisions to keep for this entity.
 * @param int $max
 *   Maximum amount of revisions to delete per run. Defaults to 50,
 *   may be increased or decreased for performance.
 *
 */
function _bellcom_borgerdk_entity_revision_delete($entity_type, $entity_id, $revisions_to_keep, $max) {

  $revisions = _bellcom_borgerdk_entity_revision_list($entity_type, $entity_id);
  // Keep recent revisions.
  $revisions = array_slice($revisions, $revisions_to_keep);
  // Reverse the list so we start deleting oldest revisions first.
  $revisions = array_reverse($revisions);
  $deleted_revisions = 0;
  foreach ($revisions as $revision) {
    if ($revision->vid == $revision->current_vid) {
      continue;
    }
    call_user_func($entity_type . '_delete_revision',  $revision->vid);

    $deleted_revisions++;

      // Stop deleting if we hit the limit per cron run.
    if ($deleted_revisions == $max) {
      break;
    }
  }
}

/**
 * Returns a list of all the existing revision.
 *
 * @param int $entity_type
 *   Type of entity.
 * @param string $entity_id
 *   The Entity ID.
 *
 * @return
 *   An associative array keyed by entity revision number.
 */
function _bellcom_borgerdk_entity_revision_list($entity_type, $entity_id) {
  $revisions = array();
  $result = db_query('SELECT r.vid, r.entity_id,  m.vid AS current_vid FROM {' . $entity_type . '_revision} r LEFT JOIN {' . $entity_type . '} m ON r.vid = m.vid '
      . 'WHERE r.entity_id = :entity_id ORDER BY r.vid DESC', array(
    ':entity_id' =>$entity_id,
  ));
  foreach ($result as $revision) {
    $revisions[$revision->vid] = $revision;
  }
  return $revisions;
}

/**
 * Function for delete old revisions in cron.
 */
function bellcom_borgerdk_entity_revision_cleanup() {
  if (variable_get('bellcom_borgerdk_entity_revision_cleanup_enabled', FALSE)) {
    $max = (int) variable_get('bellcom_borgerdk_entity_revision_delete_per_cron', 50);
    $revisions_to_keep = variable_get('bellcom_borgerdk_entity_revision_max_number', 10);

    //remove borgerdk_microarticle_revisions
    $microarticle_candidate_ids = bellcom_borgerdk_entity_revision_delete_candidates('borgerdk_microarticle', $revisions_to_keep);
    if (!empty($microarticle_candidate_ids)) {
      foreach ($microarticle_candidate_ids as $entity_id) {
        _bellcom_borgerdk_entity_revision_delete('borgerdk_microarticle', $entity_id, $revisions_to_keep, $max);
      }
    }
    //remove borgerdk_selfservice_revision
    $selfservice_candidate_ids = bellcom_borgerdk_entity_revision_delete_candidates('borgerdk_selfservice', $revisions_to_keep);
    if (!empty($selfservice_candidate_ids)) {
      foreach ($selfservice_candidate_ids as $entity_id) {
        _bellcom_borgerdk_entity_revision_delete('borgerdk_selfservice', $entity_id, $revisions_to_keep, $max);
      }
    }
  }
}