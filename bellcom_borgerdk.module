  /** Borger.dk Selfservice section end */

  return $items;
}

/**
 * Implements hook_cron()
 *
 * fetches the latest info about articles.
 * Add the articles that need to be resynched to the dedicated queue.
 */
function bellcom_borgerdk_cron() {
  // Check if we should run import/update of articles.
  //$time_interval = variable_get('borger_articles_cron_job_interval', 24);
  //$last_execute = variable_get('borger_articles_cron_last_execute', 0);
  //$next_execute = $last_execute + $time_interval * 60 * 60;

  //if ($next_execute <= time()) {
  // Create queue to handle all articles.
  $queue = DrupalQueue::get(BELLCOM_BORGERDK_QUEUE);

  if ($queue_size = $queue->numberOfItems()) {
    watchdog('Bellcom Borger.dk', 'Borger.dk article queue is not empty (about @cnt articles pending update), new items will not be created.',
      array('@cnt' => $queue_size * BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE));
  }
  else {
    try {
      bellcom_borgerdk_fetch_articles();
      $articles = bellcom_borgedk_get_resynch_articles();

      // Maximum N articles to process.
      $chunks = array_chunk($articles, BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE, TRUE);
      foreach ($chunks as $chunk) {
        $queue->createItem($chunk);
      }
      watchdog('Bellcom Borger.dk', 'Borger article queue created (@cnt articles pending update).',
        array('@cnt' => count($articles)));
    } catch (Exception $e) {
      watchdog('Bellcom Borger.dk', $e->getMessage(), WATCHDOG_ERROR);
    }
  }
  //}
}

/**
 * Implements hook_cron_queue_info().
 */
function bellcom_borgerdk_cron_queue_info() {
  $queues[BELLCOM_BORGERDK_QUEUE] = array(
    'worker callback' => 'bellcom_borgerdk_queue_worker',
    'time' => 60,
  );
  return $queues;
}

