<?php
define('BELLCOM_BORGERDK_QUEUE', 'bellcom_borgerdk_cron_queue');
define('BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE', 10); //used when scheduling items to be imported
define('BELLCOM_BORGERDK_CONTROLLER_UI_PAGER_LIMIT', 25); //used when presenting items in admin overview

module_load_include('inc', 'bellcom_borgerdk', 'entities/bellcom_borgerdk_article.entity');
module_load_include('inc', 'bellcom_borgerdk', 'entities/bellcom_borgerdk_microarticle.entity');
module_load_include('inc', 'bellcom_borgerdk', 'entities/bellcom_borgerdk_selfservice.entity');
module_load_include('inc', 'bellcom_borgerdk', 'includes/bellcom_borgerdk.fields');
module_load_include('inc', 'bellcom_borgerdk', 'includes/bellcom_borgerdk.synch');
module_load_include('inc', 'bellcom_borgerdk', 'admin/bellcom_borgerdk.article.admin');
module_load_include('inc', 'bellcom_borgerdk', 'admin/bellcom_borgerdk.microarticle.admin');
module_load_include('inc', 'bellcom_borgerdk', 'admin/bellcom_borgerdk.selfservice.admin');

/**
 * Implements hook_menu()
 */
function bellcom_borgerdk_menu() {
  $items = array();

  $items += bellcom_borgedk_article_menu();
  $items += bellcom_borgerdk_microarticle_menu();
  $items += bellcom_borgerdk_selfservice_menu();

  $items['admin/config/bellcom_borgerdk'] = array(
    'title' => 'Borger.dk Settings',
    'position' => 'right',
    'weight' => -15,
    'access arguments' => array('administer borgerdk_article'),
    'page callback' => 'system_admin_menu_block_page',
    'file' => 'system.admin.inc',
    'file path' => drupal_get_path('module', 'system'),
    'type' => MENU_NORMAL_ITEM,
  );

  $items['admin/config/bellcom_borgerdk/settings'] = array(
    'title' => 'Borger.dk Settings',
    'description' => 'Settings for the Bellcom Borger.dk integration',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('bellcom_borgerdk_settings_form'),
    'access arguments' => array('administer borgerdk_article'),
    'type' => MENU_NORMAL_ITEM,
    'file' => 'admin/bellcom_borgerdk.admin.inc',
  );

  return $items;
}

/**
 * Implements hook_cron()
 *
 * fetches the latest info about articles.
 * Add the articles that need to be resynched to the dedicated queue.
 * Deleted old microarticles and selfservices revisions.
 */
function bellcom_borgerdk_cron() {

  bellcom_borgerdk_entity_revision_cleanup();

  $queue = DrupalQueue::get(BELLCOM_BORGERDK_QUEUE);

  if ($queue_size = $queue->numberOfItems()) {
    watchdog('Bellcom Borger.dk', 'Borger.dk article queue is not empty (about @cnt articles pending update), new items will not be created.',
      array('@cnt' => $queue_size * BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE));
  }
  else {
    try {
      $import_languages = variable_get('bellcom_borgerdk_entity?imported_languages', array('en', 'da'));
      if ($import_languages['da'] === 'da') {
        bellcom_borgerdk_fetch_articles('da');
      }
      if ($import_languages['en'] === 'en') {
        bellcom_borgerdk_fetch_articles('en');
      }

      // Maximum N articles to process.
      $articles_da = bellcom_borgedk_get_resynch_articles('da');
      $chunks = array_chunk($articles_da, BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE, TRUE);
      foreach ($chunks as $chunk) {
        $queue->createItem(array('lang' => 'da', 'items' => $chunk));
      }

      // Maximum N articles to process.
      $articles_en = bellcom_borgedk_get_resynch_articles('en');
      $chunks = array_chunk($articles_en, BELLCOM_BORGERDK_QUEUE_CHUNK_SIZE, TRUE);
      foreach ($chunks as $chunk) {
        $queue->createItem(array('lang' => 'en', 'items' => $chunk));
      }

      watchdog('Bellcom Borger.dk', 'Borger article queue created (@cnt articles pending update).',
        array('@cnt' => count($articles_da)+count($articles_en)));

    } catch (Exception $e) {
      watchdog('Bellcom Borger.dk', $e->getMessage(), WATCHDOG_ERROR);
    }
  }
}

/**
 * Implements hook_cron_queue_info().
 */
function bellcom_borgerdk_cron_queue_info() {
  $queues[BELLCOM_BORGERDK_QUEUE] = array(
    'worker callback' => 'bellcom_borgerdk_queue_worker',
    'time' => 60,
  );
  return $queues;
}

/**
 * Implements hook_entity_info().
 */
function bellcom_borgerdk_entity_info() {
  $info = array();

  $info += bellcom_borgedk_article_entity_info();
  $info += bellcom_borgedk_microarticle_entity_info();
  $info += bellcom_borgerdk_selfservice_entity_info();

  return $info;
}

