/** borgerdk_article entity functions */
function borgerdk_article_load($entity_id = NULL, $reset = FALSE) {
  $articles = borgerdk_article_load_multiple(array($entity_id), array(), $reset);
  return reset($articles);
}

function borgerdk_article_load_multiple($entity_ids = FALSE, $conditions = array(), $reset = FALSE) {
  return entity_load('borgerdk_article', $entity_ids, $conditions, $reset);
}

function borgerdk_article_save($entity) {
  entity_save('borgerdk_article', $entity);
}

function borgerdk_article_delete($entity) {
  //TODO: add deletion of child elements as well as removing it from the node
  entity_delete('borgerdk_article', entity_id('borgerdk_article', $entity));
}

function borgerdk_article_delete_multiple($entity_ids) {
  entity_delete_multiple('borgerdk_article', $entity_ids);
}

function borgerdk_article_access($op, $entity, $account = NULL, $entity_type) {
  if ($op == 'create') {
    return user_access('administer borgerdk_article');
  }
  if (isset($entity)) {
    $account = isset($account) ? $account : $GLOBALS['user'];
    if (user_access("$op borgerdk_article", $account)) {
      return TRUE;
    }
  }
}

/** borgerdk_microarticle entity functions */
function borgerdk_microarticle_load($entity_id = NULL, $reset = FALSE) {
  $entities = borgerdk_microarticle_load_multiple(array($entity_id), array(), $reset);
  return reset($entities);
}

function borgerdk_microarticle_load_multiple($entity_ids = FALSE, $conditions = array(), $reset = FALSE) {
  return entity_load('borgerdk_microarticle', $entity_ids, $conditions, $reset);
}

function borgerdk_microarticle_save($entity) {
  entity_save('borgerdk_microarticle', $entity);
}

function borgerdk_microarticle_delete($entity) {
  entity_delete('borgerdk_microarticle', entity_id('borgerdk_microarticle', $entity));
}

function borgerdk_microarticle_delete_multiple($entity_ids) {
  entity_delete_multiple('borgerdk_microarticle', $entity_ids);
}

function borgerdk_microarticle_access($op, $entity, $account = NULL, $entity_type) {
  if ($op == 'create') {
    return user_access('administer borgerdk_article');
  }
  if ($entity) {
    //relay on article access
    $article = borgerdk_article_load($entity->article_id);
    return borgerdk_article_access($op, $article, $account, 'borgerdk_article');
  }
}

/** borgerdk_selfservice entity functions */
function borgerdk_selfservice_load($entity_id = NULL, $reset = FALSE) {
  $entities = borgerdk_selfservice_load_multiple(array($entity_id), array(), $reset);
  return reset($entities);
}

function borgerdk_selfservice_load_multiple($entity_ids = FALSE, $conditions = array(), $reset = FALSE) {
  return entity_load('borgerdk_selfservice', $entity_ids, $conditions, $reset);
}

function borgerdk_selfservice_save($entity) {
  entity_save('borgerdk_selfservice', $entity);
}

function borgerdk_selfservice_delete($entity) {
  entity_delete('borgerdk_selfservice', entity_id('borgerdk_selfservice', $entity));
}

function borgerdk_selfservice_delete_multiple($entity_ids) {
  entity_delete_multiple('borgerdk_selfservice', $entity_ids);
}

function borgerdk_selfservice_access($op, $entity, $account = NULL, $entity_type) {
  if ($op == 'create') {
    return user_access('administer borgerdk_article');
  }
  if ($entity) {
    //relay on article access
    $article = borgerdk_article_load($entity->article_id);
    return borgerdk_article_access($op, $article, $account, 'borgerdk_article');
  }
}